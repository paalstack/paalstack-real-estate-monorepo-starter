# ──────────────────────────────────────────────────────────────────────────────
# Real Estate Starter — Database package env
# ──────────────────────────────────────────────────────────────────────────────
# Mirror the root .env (or rely on global envs from Turbo). The DATABASE_URL
# through PgBouncer for runtime; DIRECT_DATABASE_URL bypasses it for the
# schema/RLS bootstrap (migrations, session vars).
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://starter:starter@localhost:6432/starter_crm?schema=public
DIRECT_DATABASE_URL=postgresql://starter:starter@localhost:5432/starter_crm?schema=public
POOL_MODE=session

# Seed users (mirrors .env.example seed defaults)
SEED_ADMIN_EMAIL=admin@example.in
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=changeme
SEED_MANAGER_EMAIL=manager@example.in
SEED_MANAGER_NAME=Manager
SEED_MANAGER_PASSWORD=changeme
SEED_TELECALLER_EMAIL=telecaller@example.in
SEED_TELECALLER_NAME=Telecaller
SEED_TELECALLER_PASSWORD=changeme