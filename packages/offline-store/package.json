{
  "name": "@starter/offline-store",
  "version": "0.1.0",
  "private": true,
  "description": "Starter — Platform-agnostic offline data store: IDB-backed mutation queue, photo blob store, TanStack Query persistence, LWW conflict resolver. Consumed by apps/web (PWA) and apps/mobile (Expo, when added).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "idb-keyval": "6.3.0"
  },
  "peerDependencies": {
    "fake-indexeddb": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "fake-indexeddb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}